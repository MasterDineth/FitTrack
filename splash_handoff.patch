   GoRouterNotifier(this._ref) {
     _ref.listen(authProvider, (_, _) => notifyListeners());
     _ref.listen(userProfileProvider, (_, _) => notifyListeners());
+    _ref.listen(splashDoneProvider, (_, _) => notifyListeners());
